# Render environment only. Use a randomly generated secret, at least 32 characters.
DASHBOARD_SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
DASHBOARD_SESSION_TTL_SECONDS=28800
# Paste the complete Firebase service-account JSON as ONE environment variable.
# This is separate from the existing GOOGLE_CREDENTIALS used for Sheets.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Astina can alternatively be stored in OFFICER; its role is always restricted.
# Recommended: set a Werkzeug scrypt password hash here (never plaintext).
CRISIS_ASTINA_PASSWORD_HASH=
# Exact frontend origins, comma-separated. Required for production WebSockets.
CRISIS_ALLOWED_ORIGINS=https://pikdashboard.vercel.app,http://localhost:3000,http://127.0.0.1:3000
