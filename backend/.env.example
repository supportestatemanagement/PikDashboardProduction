# Render environment only. Use a randomly generated secret, at least 32 characters.
DASHBOARD_SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
DASHBOARD_SESSION_TTL_SECONDS=28800
# Paste the complete Firebase service-account JSON as ONE environment variable.
# This is separate from the existing GOOGLE_CREDENTIALS used for Sheets.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Astina can alternatively be stored in OFFICER; its role is always restricted.
# Recommended: set a Werkzeug scrypt password hash here (never plaintext).
CRISIS_ASTINA_PASSWORD_HASH=
# Exact frontend origins, comma-separated. Required for production WebSockets.
CRISIS_ALLOWED_ORIGINS=https://pikdashboard.vercel.app,http://localhost:3000,http://127.0.0.1:3000

# TURN credentials, server-side only. Choose metered, coturn or cloudflare.
CRISIS_TURN_PROVIDER=metered
CRISIS_TURN_TTL_SECONDS=3600
# Debug only: true forces relay; production must use false.
CRISIS_TURN_FORCE_RELAY=false
# Metered Developers credentials: never expose Secret key outside backend.
# Domain example: yourapp.metered.live (HTTPS prefix also accepted).
# APP_ID labels credentials; it is not an undocumented API path parameter.
CRISIS_TURN_METERED_APP_ID=
CRISIS_TURN_METERED_DOMAIN=
CRISIS_TURN_METERED_SECRET_KEY=
# Coturn: must match use-auth-secret/static-auth-secret on your TURN server.
CRISIS_TURN_URLS=
CRISIS_TURN_SHARED_SECRET=
# Cloudflare: use the TURN key's ID and credential-generation API token.
CRISIS_TURN_CLOUDFLARE_KEY_ID=
CRISIS_TURN_CLOUDFLARE_API_TOKEN=
